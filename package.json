{
  "name": "ranking-store-api",
  "version": "2.2.0",
  "type": "module",
  "description": "The Ranking Store API — AI Visibility Scan Engine, Report Generator, Email Automation & Follow-Up System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "uuid": "^10.0.0",
    "better-sqlite3": "^11.3.0"
  }
}

