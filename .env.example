# The Ranking Store API — Environment Variables
# Copy to .env for local dev. Set in Render Dashboard for production.
# Never commit this file. Never share secret values.

# Server
NODE_ENV=production
PORT=10000

# Test Mode — must remain enabled until Rick explicitly disables it
# When enabled, ALL emails go to rick@therankingstore.io only
TEST_MODE=true

# Mailgun — set MAILGUN_API_KEY in Render Dashboard only
# Do not hard-code the key anywhere
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.therankingstore.io
MAILGUN_FROM=Rick Fleming <rick@therankingstore.io>
MAILGUN_REPLY_TO=rick@therankingstore.io

# CORS
CORS_ORIGIN=https://therankingstore.io

# Internal
INTERNAL_EMAIL=rick@therankingstore.io

# Persistent storage (Render paid plan — persistent disk at /var/data)
DATABASE_PATH=/var/data/leads.db
REPORT_STORAGE_PATH=/var/data/reports

# Public URLs
PUBLIC_API_URL=https://api.therankingstore.io
PUBLIC_SITE_URL=https://therankingstore.io

# Secrets — set in Render Dashboard
SESSION_SECRET=
ADMIN_SECRET=